          {
            "hadSpecificPurpose": "Datenerfassung (Capture) – Streifenlicht-Scanning & Makro-Photogrammetrie",
            "startDate": "2025-01-30",
            "endDate": "2025-01-30",
            "methods": [
              "Structured-light 3D scanning",
              "Close-range photogrammetry"
            ],
            "techniques": [
              "Freihand-Erfassung im Ausstellungsraum (keine Stative/Kabel erlaubt). Grenzen: Rückseite wandseitig und Unterseite aus konservatorischen Gründen nicht erfasst (Limit)."
            ],
            "materials": [
              "Pentelischer Marmor",
              "Sandstein"
            ],
            "equipment": [
              "Artec Leo (structured-light 3D scanner, 0.1 mm resolution)",
              "Nikon Z8 (digital camera, 16k textures)"
            ]
          },
          {
            "hadSpecificPurpose": "Modellierung (Representation) – Master-Mesh & VR-Echtzeitderivat",
            "startDate": "2025-02-01",
            "endDate": "2025-04-19",
            "methods": [
              "High-poly scan fusion",
              "Mesh decimation",
              "PBR texture baking"
            ],
            "techniques": [
              "Sandsteinsockel für didaktische VR-Nutzung entfernt (Entscheidung). Marmor-Transluzenz mittels Subsurface Scattering simuliert (Simulation). Normal- und AO-Maps aus High-Poly-Master gebacken. Mesh-Fusion und Oberflächenschließung via Artec Studio 19 (deklarierte Blackbox)."
            ],
            "materials": [
              "Pentelischer Marmor"
            ],
            "equipment": [
              "Artec Studio 19",
              "Blender 4.2",
              "Substance Designer 14",
